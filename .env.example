# Copia este fichero a .env (en la misma carpeta que este .env.example,
# o donde apunte CONOCIMIENTO_HOME si este repo está embebido como
# submódulo de otro — ver config/paths.py) y rellena los valores reales.
# .env está en .gitignore — nunca se sube al repo.

# Obligatoria: clave de la API de Anthropic, usada para generar las
# respuestas tipo tutorial y para sugerir tags/carpeta al clasificar.
ANTHROPIC_API_KEY=

# Opcional: solo si en la pestaña Chat del panel Streamlit vas a elegir
# OpenAI como proveedor (adapters/out/llm_openai.py). Anthropic sigue
# siendo el único proveedor usado por el bot de Telegram y por
# `reorganizar`.
OPENAI_API_KEY=

# Opcional: PROVEEDOR_LLM=mock permite desarrollar sin gastar tokens
# (genera respuestas heurísticas de prueba). Por defecto: anthropic.
PROVEEDOR_LLM=anthropic

# Obligatoria si quieres el bot de Telegram (el "proceso funcionando en
# el ordenador" que permite preguntar desde cualquier sitio). Se crea
# hablando con @BotFather en Telegram.
TELEGRAM_BOT_TOKEN=

# Opcional: restringe qué chat_id de Telegram puede usar el bot (el
# tuyo). Sin esto, cualquiera que encuentre el bot podría escribirle.
TELEGRAM_CHAT_ID_PERMITIDO=

# Opcionales: rutas de las carpetas vault. Sin definir, se resuelven
# contra config/paths.py:home() (el propio conocimiento_app en modo
# standalone, o CONOCIMIENTO_HOME si este repo está embebido como
# submódulo de otro). NO las fijes aquí como ruta relativa
# ("./vault_out"): se interpretaría relativa al directorio de trabajo
# del proceso, no a home(), reintroduciendo la fragilidad que
# config/paths.py existe para evitar.
# VAULT_IN_PATH=
# VAULT_OUT_PATH=

# Opcional, DEBUG|INFO|WARNING|ERROR. Por defecto INFO.
LOG_LEVEL=INFO
